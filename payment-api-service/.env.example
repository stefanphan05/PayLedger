# Copy to .env before starting the stack.
# Compose reads this file for the Postgres container's credentials, and Spring
# reads it via spring.config.import in application.yml. The values below match
# docker-compose.yml as-is, so no editing is needed for local development.
DB_URL=jdbc:postgresql://localhost:5432/payment_db
DB_USERNAME=user
DB_PASSWORD=password

# Local development only - this is not a real secret and is safe to commit.
# Generate your own for anything deployed: openssl rand -base64 32
JWT_SECRET=ytUj+eUXr1nQQ6dLxymUCSmWcxFaMblTgXtWUcTdIYM=

# Optional - these are the defaults.
# REDIS_HOST=localhost
# REDIS_PORT=6379
