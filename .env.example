# Copy to .env before starting the stack.
#
# One file at the repo root for the whole system: Compose reads it for the Postgres
# containers' credentials, and each service reads it via spring.config.import in its
# application.yml. Variables are prefixed by the service that owns them, so adding a
# third service never means guessing which DB_USERNAME is which.
#
# The values below match docker-compose.yml as-is. Only GEMINI_API_KEY at the bottom
# has to be filled in yourself; everything else works for local development untouched.

# payment-api-service -> payments-db (host port 5432)
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=user
PAYMENT_DB_PASSWORD=password

# ledger-service -> ledger-db (host port 5433; 5432 is already taken by payments-db)
LEDGER_DB_URL=jdbc:postgresql://localhost:5433/ledger_db
LEDGER_DB_USERNAME=user
LEDGER_DB_PASSWORD=password

# Local development only - this is not a real secret and is safe to commit.
# Generate your own for anything deployed: openssl rand -base64 32
JWT_SECRET=ytUj+eUXr1nQQ6dLxymUCSmWcxFaMblTgXtWUcTdIYM=

# Optional - these are the defaults.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Kafka. The compose broker publishes 9092 to the host, so this is what
# ./gradlew bootRun connects to. Override to point at a real cluster.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# insights-service -> insights-db (host port 5434; 5432 and 5433 are taken)
INSIGHTS_DB_USERNAME=user
INSIGHTS_DB_PASSWORD=password

# insights-service -> Google Gemini, which writes the answers.
# The one value you have to supply yourself. Free, no card required:
# https://aistudio.google.com/apikey
# Without it the stack still starts and payments work; only /insights/ask fails.
GEMINI_API_KEY=
